# ---- LLM (pick one provider) -------------------------------------------------
# Anthropic (default)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Together, DeepSeek, Gemini's /openai):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
#   Gemini:     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- Time budgets ---------------------------------------------------------------
# Defaults (13s) fit magicpin's local judge_simulator.py, which times out at 15s.
# For the real judge (30s timeout) you can raise them for more repair headroom:
# TICK_BUDGET_SECONDS=25
# REPLY_BUDGET_SECONDS=25
# LLM_CALL_TIMEOUT=12
# LLM_CONCURRENCY=6

# ---- /v1/metadata ------------------------------------------------------------------
TEAM_NAME=
TEAM_MEMBERS=
CONTACT_EMAIL=
